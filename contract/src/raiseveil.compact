pragma language_version 0.28.0;

import CompactStandardLibrary;

export sealed ledger trustedSignerPk: JubjubPoint;

struct Trader {
    tradeCount: Field;
    tradeVolume: Field;
    averageTradeSize: Field;
    averageReturn: Field;
    startDate: Field;
    lastTradeDate: Field;
}

struct CredentialNullifierInput {
    domain: Bytes<32>;
    subjectId: Field;
    policyId: Field;
}

export ledger activityBadge: Field;
export ledger usedActivityCredentials: Set<Bytes<32>>;

witness getAttestedTraderDataWitness(): [Trader, JubjubSchnorrSignature, Field, Field];

constructor(pk: JubjubPoint) {
    trustedSignerPk = disclose(pk);
}

export circuit verifyData(): [] {
    const [data, signature, subjectId, activityPolicyId] = getAttestedTraderDataWitness();

    const msg: Vector<8, Field> = [
        data.tradeCount,
        data.tradeVolume,
        data.averageTradeSize,
        data.averageReturn,
        data.startDate,
        data.lastTradeDate,
        subjectId,
        activityPolicyId
    ];

    assert(jubjubSchnorrVerify<8>(msg, signature, trustedSignerPk), "Attestation Failed");

    assert(
        activityPolicyId == (1 as Field) || activityPolicyId == (2 as Field),
        "Activity Policy Not Met"
    );
    assert(subjectId != (0 as Field), "Invalid Subject");

    const credentialNullifier = persistentHash<CredentialNullifierInput>(
        CredentialNullifierInput{
            domain: pad(32, "raiseveil:activity:nul:"),
            subjectId: subjectId,
            policyId: activityPolicyId
        }
    );
    assert(!usedActivityCredentials.member(disclose(credentialNullifier)),
           "Activity Credential Already Used");
    usedActivityCredentials.insert(disclose(credentialNullifier));

    activityBadge = disclose(activityPolicyId);
}