{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "raiseveil-api": {
      "root": "raiseveil-api",
      "framework": "hono",
      "entrypoint": "src/index.mts",
      "buildCommand": "npm run build",
      "bindings": [
        {
          "type": "service",
          "service": "raiseveil-attestation-api",
          "format": "url",
          "env": "RAISEVEIL_ATTESTATION_API_URL"
        }
      ]
    },
    "raiseveil-attestation-api": {
      "root": "raiseveil-attestation-api",
      "framework": "hono",
      "entrypoint": "src/index.ts",
      "buildCommand": "npm run build",
      "functions": {
        "src/index.ts": {
          "includeFiles": "package.json"
        }
      }
    },
    "raiseveil-ui": {
      "root": "raiseveil-ui",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "raiseveil-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "raiseveil-ui"
      }
    }
  ]
}
