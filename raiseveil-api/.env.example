PORT=3000
HOST=127.0.0.1
NODE_ENV=development
DATABASE_URL=postgres://raiseveil:change-this-password@localhost:5432/raiseveil
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
REQUIRE_EMAIL_VERIFICATION=false
SMTP_URL=
AUTH_EMAIL_FROM=RaiseVeil <no-reply@example.com>

# Generate with: openssl rand -base64 32
BROKER_ENCRYPTION_KEY=

# Use undeployed for standalone or preprod for Midnight preprod.
MIDNIGHT_NETWORK_ID=undeployed
MIDNIGHT_INDEXER_URL=http://127.0.0.1:8088/api/v4/graphql
MIDNIGHT_INDEXER_WS_URL=ws://127.0.0.1:8088/api/v4/graphql/ws
# Required by the API and CLI for Preprod unless custom indexer URLs are set.
BLOCKFROST_PROJECT_ID=
RAISEVEIL_PROVIDER_PUBLIC_KEY_X=
RAISEVEIL_PROVIDER_PUBLIC_KEY_Y=

OANDA_API_URL=https://api-fxpractice.oanda.com
# Local only. Vercel injects this value from the API service binding.
RAISEVEIL_ATTESTATION_API_URL=http://127.0.0.1:3100
RAISEVEIL_ATTESTATION_SHARED_SECRET=
