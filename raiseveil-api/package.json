{
  "name": "raiseveil-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build --workspace raiseveil-contract && tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@midnight-ntwrk/compact-runtime": "0.20.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0-rc.4",
    "@midnight-ntwrk/midnight-js-network-id": "5.0.0-rc.4",
    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "dotenv": "^17.2.3",
    "hono": "4.13.13",
    "nodemailer": "10.1.2",
    "pg": "8.23.1",
    "raiseveil-contract": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.1",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
