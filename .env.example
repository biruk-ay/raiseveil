# Copy to .env at the repository root. Do not commit .env or real credentials.

# RaiseVeil API and PostgreSQL
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
DATABASE_URL=postgres://raiseveil:raiseveil@localhost:5432/raiseveil
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
# Generate a unique secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
REQUIRE_EMAIL_VERIFICATION=false
SMTP_URL=
AUTH_EMAIL_FROM=RaiseVeil <no-reply@example.com>

# Generate with: openssl rand -base64 32
BROKER_ENCRYPTION_KEY=

# Server-side contract/indexer integration
MIDNIGHT_NETWORK_ID=undeployed
MIDNIGHT_INDEXER_URL=http://127.0.0.1:8088/api/v4/graphql
MIDNIGHT_INDEXER_WS_URL=ws://127.0.0.1:8088/api/v4/graphql/ws
RAISEVEIL_PROVIDER_PUBLIC_KEY_X=
RAISEVEIL_PROVIDER_PUBLIC_KEY_Y=

# Broker and attestation service
OANDA_API_URL=https://api-fxpractice.oanda.com
RAISEVEIL_ATTESTATION_API_URL=http://127.0.0.1:3100
# Use the same random value in the API and attestation service secret stores.
RAISEVEIL_ATTESTATION_SHARED_SECRET=
ATTESTATION_PORT=3100
RAISEVEIL_PROVIDER_ID=1
# Keep this signing secret only in the attestation service's secret environment.
RAISEVEIL_PROVIDER_SECRET_KEY=

# Local verification CLI
RAISEVEIL_NETWORK=standalone
BLOCKFROST_PROJECT_ID=
MIDNIGHT_WALLET_SEED=
RAISEVEIL_PRIVATE_STATE_PASSWORD=
DEBUG_LEVEL=
